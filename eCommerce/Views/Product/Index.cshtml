@model IEnumerable<Product>
@{
    ViewData["Title"] = "Product Listings";

    // TYPE THIS IN: Declare variables at the top of the file
    int currentPage = ViewData["CurrentPage"] != null ? (int)ViewData["CurrentPage"] : 1;
    int totalPages = ViewData["TotalPages"] != null ? (int)ViewData["TotalPages"] : 0;
}

<h2>Product Listings</h2>

<a asp-action="Create" asp-controller="Product" class="btn btn-success">Create New Product</a>

<form asp-action="Index" method="get" class="mb-4 mt-3">
    <div class="row g-2 align-items-center">
        <div class="col-auto">
            <input type="text" name="searchString" class="form-control" placeholder="Search by title..." value="@ViewData["SearchString"]" />
        </div>
        <div class="col-auto">
            <input type="number" step="0.01" name="minPrice" class="form-control" placeholder="Min price" value="@ViewData["MinPrice"]" />
        </div>
        <div class="col-auto">
            <input type="number" step="0.01" name="maxPrice" class="form-control" placeholder="Max price" value="@ViewData["MaxPrice"]" />
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-primary">Search</button>
            <a asp-action="Index" class="btn btn-secondary">Clear</a>
        </div>
    </div>
</form>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mt-3" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}


@if (Model != null && Model.Any())
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>@Html.DisplayNameFor(model => model.Title)</th>
                <th>@Html.DisplayNameFor(model => model.Price)</th>
                <th>@Html.DisplayNameFor(model => model.Description)</th>
                <th>Links</th>
            </tr>
        </thead>
        <tbody>
            @foreach (Product product in Model)
            {
                <tr>
                    <td>@Html.DisplayFor(p => product.Title)</td>
                    <td>@Html.DisplayFor(p => product.Price)</td>
                    <td>@Html.DisplayFor(p => product.Description)</td>
                    <td><a class="btn btn-primary" asp-controller="Product" asp-action="Edit" asp-route-id="@product.ProductId">Update</a></td>
                    <td><a class="btn btn-danger" asp-controller="Product" asp-action="Delete" asp-route-id="@product.ProductId">Delete</a></td>
                </tr>
            }
        </tbody>
    </table>


    <!-- Pagination -->


    if (totalPages > 1)
    {
        <nav aria-label="Page navigation" class="mt-4">
            <ul class="pagination">
                @if (currentPage > 1)
                {
                    <li class="page-item">
                        <a class="page-link" asp-action="Index" asp-route-page="1" asp-route-searchString="@ViewData["SearchString"]"
                           asp-route-minPrice="@ViewData["MinPrice"]"
                           asp-route-maxPrice="@ViewData["MaxPrice"]">First</a>
                    </li>
                    <li class="page-item">
                        <a class="page-link" asp-action="Index" asp-route-page="@(currentPage - 1)" asp-route-searchString="@ViewData["SearchString"]"
                           asp-route-minPrice="@ViewData["MinPrice"]"
                           asp-route-maxPrice="@ViewData["MaxPrice"]">Previous</a>
                    </li>
                }

                @for (int i = Math.Max(1, currentPage - 2); i <= Math.Min(totalPages, currentPage + 2); i++)
                {
                    @if (i == currentPage)
                    {
                        <li class="page-item active"><span class="page-link">@i</span></li>
                    }
                    else
                    {
                        <li class="page-item">
                            <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-searchString="@ViewData["SearchString"]"
                               asp-route-minPrice="@ViewData["MinPrice"]"
                               asp-route-maxPrice="@ViewData["MaxPrice"]">@i</a>
                        </li>
                    }
                }

                @if (currentPage < totalPages)
                {
                    <li class="page-item">
                        <a class="page-link" asp-action="Index" asp-route-page="@(currentPage + 1)"
                           asp-route-searchString="@ViewData["SearchString"]"
                           asp-route-minPrice="@ViewData["MinPrice"]"
                           asp-route-maxPrice="@ViewData["MaxPrice"]">Next</a>
                    </li>
                    <li class="page-item">
                        <a class="page-link" asp-action="Index" asp-route-page="@(currentPage - 1)"
                           asp-route-searchString="@ViewData["SearchString"]"
                           asp-route-minPrice="@ViewData["MinPrice"]"
                           asp-route-maxPrice="@ViewData["MaxPrice"]">Last</a>
                    </li>
                }
            </ul>
        </nav>
        <p class="text-muted">Page @currentPage of @totalPages</p>
    }
}
else
{
    <div class="alert alert-info">No products available.</div>
}